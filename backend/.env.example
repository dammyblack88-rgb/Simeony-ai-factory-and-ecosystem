# Bind to loopback by default. Do not expose this unauthenticated API to the internet.
SIMEONY_HOST=127.0.0.1
SIMEONY_PORT=8765
SIMEONY_ENABLE_LAN=false

# Optional local engine endpoints. A failed probe is shown as unavailable.
SIMEONY_OLLAMA_URL=http://127.0.0.1:11434
SIMEONY_COMFYUI_URL=http://127.0.0.1:8188
